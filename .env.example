# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=dall-e-3   # or gpt-image-1

# Admin panel credentials
ADMIN_USER=admin
ADMIN_PASS=changeme123

# Public URL of the app (shown in admin panel link list)
BASE_URL=https://your-app.up.railway.app

# Persistent data directory.
# On Railway: set to /data (the volume mount path).
# Locally: leave empty → falls back to ./data/
DATA_DIR=/data

# Server port — Railway injects this automatically, do not set manually
# PORT=3000
